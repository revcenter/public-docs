    },
    {
      "source": "/recipes/coding-agent",
      "destination": "/tools/mcp"
    },
    {
      "source": "/use-cases/executive-search",
      "destination": "/guides/writing-a-search"
    },
    {
      "source": "/use-cases/client-shortlists",
      "destination": "/guides/searches"
    },
    {
      "source": "/use-cases/agent-research",
      "destination": "/tools/mcp"
    },
    {
      "source": "/concepts/cli-basics",
      "destination": "/tools/mcp"
    },
    {
      "source": "/tools/cli",
      "destination": "/tools/mcp"
    },
    {
      "source": "/guides/webhooks",
      "destination": "/guides/api-essentials"
    }
