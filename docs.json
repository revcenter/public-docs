{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Revcenter",
  "description": "Find the right candidates for a role, see why each one fits, and send your client a shortlist.",
  "colors": {
    "primary": "#1A1A1A",
    "light": "#E5E5E5",
    "dark": "#000000"
  },
  "appearance": {
    "default": "light",
    "strict": false
  },
  "api": {
    "playground": {
      "display": "interactive"
    },
    "examples": {
      "languages": [
        "curl",
        "javascript",
        "python"
      ]
    }
  },
  "navigation": {
    "groups": [
      {
        "group": "For recruiters",
        "pages": [
          "introduction",
          "pricing",
          "guides/writing-a-search",
          "guides/searches",
          "tools/connectors"
        ]
      },
      {
        "group": "For developers",
        "pages": [
          "authentication",
          "tools/mcp",
          "guides/api-essentials",
          "guides/criteria",
          "guides/exports",
          "recipes/backend-job"
        ]
      },
      {
        "group": "API reference",
        "openapi": "openapi.json",
        "pages": [
          "api-reference/introduction",
          "GET /health",
          "GET /me",
          "GET /me/usage",
          "POST /billing/top-up",
          "GET /actions",
          "POST /actions/preview",
          "POST /proposals/apply",
          "GET /reference/criteria",
          "GET /reference/export-columns",
          "POST /criteria/draft",
          "GET /reference/industries",
          "GET /projects",
          "POST /projects",
          "GET /projects/{projectId}",
          "PATCH /projects/{projectId}",
          "GET /projects/{projectId}/insights",
          "GET /projects/{projectId}/stats",
          "GET /projects/{projectId}/spend",
          "GET /projects/{projectId}/dnc",
          "POST /projects/{projectId}/dnc",
          "POST /projects/{projectId}/dnc/from-search/{searchId}",
          "DELETE /projects/{projectId}/dnc/{entryId}",
          "GET /projects/{projectId}/searches",
          "GET /projects/{projectId}/records",
          "GET /projects/{projectId}/records.csv",
          "POST /projects/{projectId}/searches",
          "GET /searches/{searchId}",
          "POST /searches/{searchId}/cancel",
          "GET /searches/{searchId}/people",
          "GET /searches/{searchId}/records",
          "GET /searches/{searchId}/records.csv",
          "POST /projects/{projectId}/expand",
          "POST /searches/{searchId}/scoring/preview",
          "POST /searches/{searchId}/scoring/apply",
          "GET /searches/{searchId}/scoring/jobs/{jobId}",
          "POST /searches/{searchId}/database-pass",
          "GET /searches/{searchId}/scoring",
          "POST /searches/{searchId}/scoring/discard",
          "POST /searches/{searchId}/rescore",
          "GET /searches/{searchId}/thread",
          "GET /projects/{projectId}/shortlist",
          "GET /projects/{projectId}/shortlist.csv",
          "GET /projects/{projectId}/share-link",
          "POST /projects/{projectId}/shortlist/members",
          "DELETE /projects/{projectId}/shortlist/members/{candidateId}",
          "POST /searches/{searchId}/candidates/{candidateId}/verdict",
          "GET /searches/{searchId}/verdicts",
          "GET /decline-reasons",
          "POST /decline-reasons",
          "GET /projects/{projectId}/shortlist/versions",
          "GET /projects/{projectId}/shortlist/versions/{versionId}",
          "GET /projects/{projectId}/shortlist/versions/{versionId}.csv",
          "POST /projects/{projectId}/shortlist/publish",
          "POST /projects/{projectId}/shortlist/email/preview",
          "POST /projects/{projectId}/shortlist/email/send",
          "GET /projects/{projectId}/client-feedback",
          "GET /candidates",
          "GET /companies",
          "GET /candidates.csv"
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "For developers",
        "href": "/tools/mcp"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open Revcenter",
      "href": "https://app.revcenter.ai"
    }
  },
  "footer": {
    "socials": {}
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "favicon": "/favicon.svg",
